import go errors from "errors";
import go fmt from "fmt";
import go mime from "mime";
import go http from "net/http";
import go math from "math";
import go net from "net";
import go mail from "net/mail";
import go url from "net/url";
import go regexp from "regexp";
import go strings from "strings";
import go time from "time";
import go utf8 from "unicode/utf8";

export struct Issue {
  public field: string;
  public code: string;
  public message: string;
}

export class Validator {
  private problems: Issue[];

  constructor() {
    this.problems = [];
  }

  public function valid(): boolean {
    return len(this.problems) == 0;
  }

  public function size(): int {
    return len(this.problems);
  }

  public function all(): Issue[] {
    return copyIssues(this.problems);
  }

  public function clear(): void {
    this.problems = [];
  }

  public function forField(field: string): Result<Issue[]> {
    validatePath(field)?;
    let matches: Issue[] = [];
    for (const issue of this.problems) {
      if (issue.field == field) {
        matches = append(matches, issue);
      }
    }
    return ok(matches);
  }

  public function has(field: string): Result<boolean> {
    validatePath(field)?;
    for (const issue of this.problems) {
      if (issue.field == field) {
        return ok(true);
      }
    }
    return ok(false);
  }

  public function addAll(issues: Issue[]): Result<void> {
    for (const issue of issues) {
      validateIssue(issue)?;
    }
    for (const issue of issues) {
      this.problems = append(this.problems, issue);
    }
    return ok();
  }

  public function reject(field: string, code: string, message: string): Result<void> {
    const issue = newIssue(field, code, message);
    validateIssue(issue)?;
    this.problems = append(this.problems, issue);
    return ok();
  }

  public function required(field: string, value: string): Result<void> {
    validatePath(field)?;
    if (strings.TrimSpace(value) == "") {
      this.problems = append(this.problems, newIssue(field, "required", field + " is required"));
    }
    return ok();
  }

  public function requiredIf(field: string, value: string, condition: boolean): Result<void> {
    validatePath(field)?;
    if (condition && strings.TrimSpace(value) == "") {
      this.problems = append(this.problems, newIssue(field, "required_if", field + " is required under this condition"));
    }
    return ok();
  }

  public function requiredUnless(field: string, value: string, condition: boolean): Result<void> {
    validatePath(field)?;
    if (!condition && strings.TrimSpace(value) == "") {
      this.problems = append(this.problems, newIssue(field, "required_unless", field + " is required unless the condition holds"));
    }
    return ok();
  }

  public function requiredWith(field: string, value: string, others: string[]): Result<void> {
    validatePath(field)?;
    validateRelated(others)?;
    for (const other of others) {
      if (strings.TrimSpace(other) != "") {
        if (strings.TrimSpace(value) == "") {
          this.problems = append(this.problems, newIssue(field, "required_with", field + " is required with related values"));
        }
        return ok();
      }
    }
    return ok();
  }

  public function requiredWithout(field: string, value: string, others: string[]): Result<void> {
    validatePath(field)?;
    validateRelated(others)?;
    for (const other of others) {
      if (strings.TrimSpace(other) == "") {
        if (strings.TrimSpace(value) == "") {
          this.problems = append(this.problems, newIssue(field, "required_without", field + " is required without related values"));
        }
        return ok();
      }
    }
    return ok();
  }

  public function same(field: string, value: string, otherField: string, otherValue: string): Result<void> {
    validatePath(field)?;
    validatePath(otherField)?;
    if (value != otherValue) {
      this.problems = append(this.problems, newIssue(field, "same", field + " must match " + otherField));
    }
    return ok();
  }

  public function different(field: string, value: string, otherField: string, otherValue: string): Result<void> {
    validatePath(field)?;
    validatePath(otherField)?;
    if (value == otherValue) {
      this.problems = append(this.problems, newIssue(field, "different", field + " must differ from " + otherField));
    }
    return ok();
  }

  public function compareInteger(field: string, value: int64, operator: string, otherField: string, otherValue: int64): Result<void> {
    validatePath(field)?;
    validatePath(otherField)?;
    validateOperator(operator)?;
    if (!orderedComparison(value < otherValue, value == otherValue, operator)) {
      this.problems = append(this.problems, newIssue(field, "compare_integer", field + " must be " + operator + " " + otherField));
    }
    return ok();
  }

  public function compareNumber(field: string, value: float64, operator: string, otherField: string, otherValue: float64): Result<void> {
    validatePath(field)?;
    validatePath(otherField)?;
    validateOperator(operator)?;
    if (!finite(otherValue)) {
      return fail(errors.New("comparison value must be finite"));
    }
    if (!finite(value)) {
      this.problems = append(this.problems, newIssue(field, "finite_number", field + " must be a finite number"));
    } else if (!orderedComparison(value < otherValue, value == otherValue, operator)) {
      this.problems = append(this.problems, newIssue(field, "compare_number", field + " must be " + operator + " " + otherField));
    }
    return ok();
  }

  public function arrayLength(field: string, count: int, minimum: int, maximum: int): Result<void> {
    validatePath(field)?;
    if (count < 0 || minimum < 0 || maximum < minimum) {
      return fail(errors.New("array length and bounds must be non-negative and ordered"));
    }
    if (count < minimum || count > maximum) {
      this.problems = append(this.problems, newIssue(field, "array_length", fmt.Sprintf("%s must contain between %d and %d items", field, minimum, maximum)));
    }
    return ok();
  }

  public function unique(field: string, lookup: () => Result<boolean>): Result<void> {
    validatePath(field)?;
    if (lookup == nil) {
      return fail(errors.New("uniqueness lookup must not be nil"));
    }
    const found = lookup()?;
    if (found) {
      this.problems = append(this.problems, newIssue(field, "unique", field + " is already in use"));
    }
    return ok();
  }

  public function exists(field: string, lookup: () => Result<boolean>): Result<void> {
    validatePath(field)?;
    if (lookup == nil) {
      return fail(errors.New("existence lookup must not be nil"));
    }
    const found = lookup()?;
    if (!found) {
      this.problems = append(this.problems, newIssue(field, "exists", field + " does not reference an existing record"));
    }
    return ok();
  }

  public function file(field: string, content: byte[], maximumBytes: int64, allowedTypes: string[]): Result<void> {
    validatePath(field)?;
    if (maximumBytes < 0 || len(allowedTypes) == 0) {
      return fail(errors.New("file limit must be non-negative and allowed media types must not be empty"));
    }
    let normalized: string[] = [];
    for (const allowed of allowedTypes) {
      const [mediaType, parameters, parseError] = mime.ParseMediaType(allowed);
      if (parseError !== nil || len(parameters) != 0 || strings.Contains(mediaType, "*") || !strings.Contains(mediaType, "/")) {
        return fail(errors.New("allowed media types must be exact MIME types without parameters"));
      }
      normalized = append(normalized, mediaType);
    }
    if (content == nil) {
      this.problems = append(this.problems, newIssue(field, "required_file", field + " requires a file"));
      return ok();
    }
    if (int64(len(content)) > maximumBytes) {
      this.problems = append(this.problems, newIssue(field, "file_size", fmt.Sprintf("%s must not exceed %d bytes", field, maximumBytes)));
      return ok();
    }
    const detected = strings.Split(http.DetectContentType(content), ";")[0];
    for (const allowed of normalized) {
      if (detected == allowed) { return ok(); }
    }
    this.problems = append(this.problems, newIssue(field, "file_type", field + " must have an allowed content type"));
    return ok();
  }

  public function minLength(field: string, value: string, minimum: int): Result<void> {
    validatePath(field)?;
    if (minimum < 0) {
      return fail(errors.New("minimum length must not be negative"));
    }
    if (utf8.RuneCountInString(value) < minimum) {
      this.problems = append(this.problems, newIssue(field, "min_length", fmt.Sprintf("%s must contain at least %d characters", field, minimum)));
    }
    return ok();
  }

  public function maxLength(field: string, value: string, maximum: int): Result<void> {
    validatePath(field)?;
    if (maximum < 0) {
      return fail(errors.New("maximum length must not be negative"));
    }
    if (utf8.RuneCountInString(value) > maximum) {
      this.problems = append(this.problems, newIssue(field, "max_length", fmt.Sprintf("%s must contain at most %d characters", field, maximum)));
    }
    return ok();
  }

  public function lengthRange(field: string, value: string, minimum: int, maximum: int): Result<void> {
    validatePath(field)?;
    if (minimum < 0 || maximum < 0 || minimum > maximum) {
      return fail(errors.New("length range must be non-negative and ordered"));
    }
    const length = utf8.RuneCountInString(value);
    if (length < minimum || length > maximum) {
      this.problems = append(this.problems, newIssue(field, "length_range", fmt.Sprintf("%s must contain between %d and %d characters", field, minimum, maximum)));
    }
    return ok();
  }

  public function exactLength(field: string, value: string, expected: int): Result<void> {
    validatePath(field)?;
    if (expected < 0) {
      return fail(errors.New("expected length must not be negative"));
    }
    if (utf8.RuneCountInString(value) != expected) {
      this.problems = append(this.problems, newIssue(field, "exact_length", fmt.Sprintf("%s must contain exactly %d characters", field, expected)));
    }
    return ok();
  }

  public function equal(field: string, value: string, expected: string): Result<void> {
    validatePath(field)?;
    if (value != expected) {
      this.problems = append(this.problems, newIssue(field, "equal", field + " must equal the expected value"));
    }
    return ok();
  }

  public function notEqual(field: string, value: string, disallowed: string): Result<void> {
    validatePath(field)?;
    if (value == disallowed) {
      this.problems = append(this.problems, newIssue(field, "not_equal", field + " must not equal the disallowed value"));
    }
    return ok();
  }

  public function contains(field: string, value: string, substring: string): Result<void> {
    validatePath(field)?;
    if (substring == "") {
      return fail(errors.New("required substring must not be empty"));
    }
    if (!strings.Contains(value, substring)) {
      this.problems = append(this.problems, newIssue(field, "contains", field + " must contain the required text"));
    }
    return ok();
  }

  public function startsWith(field: string, value: string, prefix: string): Result<void> {
    validatePath(field)?;
    if (prefix == "") {
      return fail(errors.New("required prefix must not be empty"));
    }
    if (!strings.HasPrefix(value, prefix)) {
      this.problems = append(this.problems, newIssue(field, "starts_with", field + " must start with the required text"));
    }
    return ok();
  }

  public function endsWith(field: string, value: string, suffix: string): Result<void> {
    validatePath(field)?;
    if (suffix == "") {
      return fail(errors.New("required suffix must not be empty"));
    }
    if (!strings.HasSuffix(value, suffix)) {
      this.problems = append(this.problems, newIssue(field, "ends_with", field + " must end with the required text"));
    }
    return ok();
  }

  public function matches(field: string, value: string, pattern: string): Result<void> {
    validatePath(field)?;
    const expression = regexp.Compile(pattern)?;
    if (!expression.MatchString(value)) {
      this.problems = append(this.problems, newIssue(field, "pattern", field + " has an invalid format"));
    }
    return ok();
  }

  public function email(field: string, value: string): Result<void> {
    validatePath(field)?;
    const [address, parseError] = mail.ParseAddress(value);
    if (parseError !== nil || address.Address != value) {
      this.problems = append(this.problems, newIssue(field, "email", field + " must be a valid email address"));
    }
    return ok();
  }

  public function httpURL(field: string, value: string): Result<void> {
    validatePath(field)?;
    const [parsed, parseError] = url.ParseRequestURI(value);
    if (parseError !== nil || (strings.ToLower(parsed.Scheme) != "http" && strings.ToLower(parsed.Scheme) != "https") || parsed.Host == "") {
      this.problems = append(this.problems, newIssue(field, "http_url", field + " must be a valid HTTP or HTTPS URL"));
    }
    return ok();
  }

  public function oneOf(field: string, value: string, choices: string[]): Result<void> {
    validatePath(field)?;
    if (len(choices) == 0) {
      return fail(errors.New("choices must not be empty"));
    }
    for (const choice of choices) {
      if (value == choice) {
        return ok();
      }
    }
    this.problems = append(this.problems, newIssue(field, "one_of", field + " must be one of the allowed values"));
    return ok();
  }

  public function integerRange(field: string, value: int64, minimum: int64, maximum: int64): Result<void> {
    validatePath(field)?;
    if (minimum > maximum) {
      return fail(errors.New("integer range must be ordered"));
    }
    if (value < minimum || value > maximum) {
      this.problems = append(this.problems, newIssue(field, "integer_range", fmt.Sprintf("%s must be between %d and %d", field, minimum, maximum)));
    }
    return ok();
  }

  public function numberRange(field: string, value: float64, minimum: float64, maximum: float64): Result<void> {
    validatePath(field)?;
    if (!finite(minimum) || !finite(maximum) || minimum > maximum) {
      return fail(errors.New("number range bounds must be finite and ordered"));
    }
    if (!finite(value)) {
      this.problems = append(this.problems, newIssue(field, "finite_number", field + " must be a finite number"));
    } else if (value < minimum || value > maximum) {
      this.problems = append(this.problems, newIssue(field, "number_range", fmt.Sprintf("%s must be between %g and %g", field, minimum, maximum)));
    }
    return ok();
  }

  public function ipAddress(field: string, value: string): Result<void> {
    validatePath(field)?;
    if (net.ParseIP(value) === nil) {
      this.problems = append(this.problems, newIssue(field, "ip_address", field + " must be a valid IP address"));
    }
    return ok();
  }

  public function cidr(field: string, value: string): Result<void> {
    validatePath(field)?;
    const [_, _, parseError] = net.ParseCIDR(value);
    if (parseError !== nil) {
      this.problems = append(this.problems, newIssue(field, "cidr", field + " must be valid CIDR notation"));
    }
    return ok();
  }

  public function uuid(field: string, value: string): Result<void> {
    validatePath(field)?;
    if (!validUUID(value)) {
      this.problems = append(this.problems, newIssue(field, "uuid", field + " must be a valid UUID"));
    }
    return ok();
  }

  public function timestamp(field: string, value: string): Result<void> {
    validatePath(field)?;
    const [_, parseError] = time.Parse(time.RFC3339, value);
    if (parseError !== nil) {
      this.problems = append(this.problems, newIssue(field, "timestamp", field + " must be an RFC3339 timestamp"));
    }
    return ok();
  }
}

export function newValidator(): Validator {
  return new Validator();
}

function validatePath(field: string): Result<void> {
  if (len(field) == 0 || strings.TrimSpace(field) != field) {
    return fail(errors.New("validation field path must not be empty or surrounded by whitespace"));
  }
  if (field[0:1] >= "0" && field[0:1] <= "9") {
    return fail(errors.New("validation field path must start with an identifier"));
  }
  for (const segment of strings.Split(field, ".")) {
    if (len(segment) > 0 && segment[0:1] >= "0" && segment[0:1] <= "9") {
      if (len(segment) > 1 && segment[0:1] == "0") {
        return fail(errors.New("array indexes must not have leading zeros"));
      }
      for (let index = 0; index < len(segment); index++) {
        if (segment[index:index + 1] < "0" || segment[index:index + 1] > "9") {
          return fail(errors.New("array indexes must contain only digits"));
        }
      }
    }
  }
  let segmentStart = true;
  for (let index = 0; index < len(field); index++) {
    const character = field[index:index + 1];
    if (character == ".") {
      if (segmentStart) {
        return fail(errors.New("validation field path contains an empty segment"));
      }
      segmentStart = true;
    } else {
      const letter = (character >= "a" && character <= "z") || (character >= "A" && character <= "Z");
      const digit = character >= "0" && character <= "9";
      if ((segmentStart && !letter && !digit && character != "_") || (!segmentStart && !letter && !digit && character != "_" && character != "-")) {
        return fail(fmt.Errorf("invalid validation field path %q", field));
      }
      segmentStart = false;
    }
  }
  if (segmentStart) {
    return fail(errors.New("validation field path must not end with a dot"));
  }
  return ok();
}

function validateCode(code: string): Result<void> {
  if (len(code) == 0) {
    return fail(errors.New("validation issue code must not be empty"));
  }
  for (let index = 0; index < len(code); index++) {
    const character = code[index:index + 1];
    const letter = character >= "a" && character <= "z";
    const digit = character >= "0" && character <= "9";
    if ((index == 0 && !letter) || (index > 0 && !letter && !digit && character != "_")) {
      return fail(fmt.Errorf("invalid validation issue code %q", code));
    }
  }
  return ok();
}

function validateIssue(issue: Issue): Result<void> {
  validatePath(issue.field)?;
  validateCode(issue.code)?;
  if (strings.TrimSpace(issue.message) == "") {
    return fail(errors.New("validation issue message must not be blank"));
  }
  return ok();
}

function finite(value: float64): boolean {
  return !math.IsNaN(value) && !math.IsInf(value, 0);
}

function validUUID(value: string): boolean {
  if (len(value) != 36) {
    return false;
  }
  for (let index = 0; index < len(value); index++) {
    const character = value[index:index + 1];
    if (index == 8 || index == 13 || index == 18 || index == 23) {
      if (character != "-") {
        return false;
      }
    } else if (!hexDigit(character)) {
      return false;
    }
  }
  return true;
}

function hexDigit(character: string): boolean {
  return (character >= "0" && character <= "9") || (character >= "a" && character <= "f") || (character >= "A" && character <= "F");
}

function newIssue(field: string, code: string, message: string): Issue {
  return Issue {
    field: field,
    code: code,
    message: message,
  };
}

function copyIssues(source: Issue[]): Issue[] {
  let copied: Issue[] = [];
  for (const issue of source) {
    copied = append(copied, issue);
  }
  return copied;
}

function validateRelated(values: string[]): Result<void> {
  if (len(values) == 0) { return fail(errors.New("related values must not be empty")); }
  return ok();
}

function validateOperator(operator: string): Result<void> {
  if (operator != "<" && operator != "<=" && operator != ">" && operator != ">=" && operator != "==" && operator != "!=") {
    return fail(errors.New("comparison operator must be <, <=, >, >=, ==, or !="));
  }
  return ok();
}

function orderedComparison(less: boolean, equal: boolean, operator: string): boolean {
  if (operator == "<") { return less; }
  if (operator == "<=") { return less || equal; }
  if (operator == ">") { return !less && !equal; }
  if (operator == ">=") { return !less; }
  if (operator == "==") { return equal; }
  return !equal;
}

export function each<T>(validator: Validator, field: string, values: T[], rule: (validator: Validator, field: string, value: T) => Result<void>): Result<void> {
  validatePath(field)?;
  if (validator == nil || rule == nil) {
    return fail(errors.New("array validator and rule must not be nil"));
  }
  const pending = newValidator();
  for (let index = 0; index < len(values); index++) {
    const itemField = fmt.Sprintf("%s.%d", field, index);
    rule(pending, itemField, values[index])?;
  }
  return validator.addAll(pending.all());
}
