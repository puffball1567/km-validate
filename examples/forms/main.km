import { newValidator, Validator, each } from "../../validate";
import go fmt from "fmt";

function validateForm(validator: Validator): Result<void> {
  validator.requiredIf("company", "", true)?;
  validator.same("password_confirmation", "wrong", "password", "secret")?;
  validator.compareInteger("end", 5, ">=", "start", 10)?;
  const emails: bstring[] = ["user@example.com", "invalid"];
  validator.arrayLength("contacts", len(emails), 1, 3)?;
  each<bstring>(validator, "contacts", emails, (items: Validator, field: bstring, value: bstring): Result<void> => {
    return items.email(field, value);
  })?;
  const content: byte[] = [104, 101, 108, 108, 111];
  validator.file("avatar", content, 1024, ["image/png"])?;
  // Replace these callbacks with scoped, parameterized database lookups.
  validator.unique("email", (): Result<boolean> => { return ok(true); })?;
  validator.exists("team_id", (): Result<boolean> => { return ok(false); })?;
  return ok();
}

function main(): void {
  const validator = newValidator();
  const [validationError] = validateForm(validator);
  if (validationError !== nil) {
    fmt.Println("validation error");
    return;
  }
  for (const issue of validator.all()) {
    fmt.Printf("%s:%s\n", issue.field, issue.code);
  }
}
